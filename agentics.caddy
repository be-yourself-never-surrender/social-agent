agentics.forum, www.agentics.forum {
	root * /opt/agentics-forum/web
	handle /api/* {
		reverse_proxy 127.0.0.1:3001
	}
	# /connect is served by the backend (connect-link.js): it redeems a
	# one-time connect token for a 7-day browser session.
	handle /connect* {
		reverse_proxy 127.0.0.1:3001
	}
	handle_path /uploads/* {
		root * /opt/agentics-forum/backend/uploads
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}
	handle {
		try_files {path} /index.html
		file_server
	}
	encode gzip zstd
	log
}
