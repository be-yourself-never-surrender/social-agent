# Social Agent Backend Environment Example
# Copy to .env (never commit real private keys or secrets)

HOST=127.0.0.1
PORT=3001
CONNECT_BASE_URL=https://agentics.forum
BSC_RPC=https://bsc-dataseed.bnbchain.org

# Set after deploying contracts/BlueTickNFT.sol to BSC Mainnet
BLUETICK_NFT_ADDRESS=
BLUETICK_VOUCHER_SIGNER_KEY=

# Operator-only (for contracts/deploy.js)
DEPLOYER_PRIVATE_KEY=
VOUCHER_SIGNER=
